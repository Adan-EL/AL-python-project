class LostFoundSys():
    '''
    The LostFoundSys class is the main system of the software.
    When started, it will interract with a database, stored as lostfound.csv file
    Currently, the class contains methods to start and exit the system,
    and methods to report, claim, display and remove items.
    '''

    # All items are maintained as instances of the Item class, in a class variable ItemList[].
    ItemList = []


    def start():
        """
        To start the system, data is read from "lostfound.csv"
        and is converted to instances of Item and is stored in ItemList
        """
        
        # =================================================================
        # [Task 1 标注]: 处理异常 - 确保文件存在，防止首次运行时出现 FileNotFoundError
        # =================================================================
        open("lostfound.csv", "a").close()  

        file1 = open("lostfound.csv", "r")  # Open the file 'lostfound.csv' with the mode 'r'. 'r': read
        str1 = file1.read()                 # The variable str1 is a string
        records = str1.split('\n')          # The variable records is a list
        LostFoundSys.ItemList.clear()       # The clear() method removes all the elements from a list. Syntax: list.clear()

        for i in range(len(records)):
            # =================================================================
            # [Task 1 标注]: 处理异常 - 拦截 split('\n') 产生的空行，防止 IndexError
            # =================================================================
            if not records[i]:              
                continue
            strTemp = records[i].split(',')
            itemTemp = Item(strTemp[0], strTemp[1], strTemp[2], strTemp[3], strTemp[4])
            LostFoundSys.ItemList.append(itemTemp)

        file1.close()                       # Close the file1
        print("\nThe BNBU Lost&Found System is started.\n")

        # The return statement can be used for possible extension of the system
        # For example, if a functionality shall be triggered by start(),
        # then the boolean value can be used to test if start() is executed sucessfully.
        return True


    def exit():
        """
        To exit the system, all instances of item in ItemList
        are over-written into the database "lostfound.csv"
        """

        file1 = open("lostfound.csv", "w")  # Open the file 'lostfound.csv' with the mode 'w'. 'w': write
        for x in LostFoundSys.ItemList:     # Notice that each element of ItemList is an object from the Item class
            file1.write(x.toString() + '\n')

        file1.close()                       # Close the file1
        print("\nThe BNBU Lost&Found System is closed.\n")

        LostFoundSys.ItemList.clear()       # Think about why do we need this line of code?

        return True


    def report(item):
        """
        To report an item, the instance of the item shall be added to Itemlist
        """
        # =================================================================
        # [Task 2 标注]: 实现了 report 功能，将物品加入列表并打印提示
        # =================================================================
        LostFoundSys.ItemList.append(item)
        print("New item " + item.name + " has been reported.")


    # The current implementation verifies the item name only, which is not ideal.
    # How it works: When there is a matching item which is not claimed yet,
    # the item's status will be updated to "Claimed".
    # Otherwise, the item will not be claimed.
    
    # =================================================================
    # [Task 3 标注]: claim 增加了 location 参数进行精准定位，后续增加密保验证
    # =================================================================
    def claim(name, location):
        """
        To claim a specific item from the current inventory
        """
        match = False
        # =================================================================
        # [Task 7 标注]: 使用 matching_items 列表收集所有匹配的物品，
        # 应对"同一地点有多个同名物品"的情况
        # =================================================================
        matching_items = []
        
        for i in LostFoundSys.ItemList:
            if i.name.lower() == name.lower() and i.location.lower() == location.lower() and i.status == "Found":
                matching_items.append(i)
                match = True

        if not match:
            print("No such item (" + name + ") found at " + location + " or it's already claimed.")
            return

        # =================================================================
        # [Task 3 & 7 标注]: 遍历所有符合条件的物品，逐一核对 secretQuestion。
        # 只要有一件物品的 secretAnswer 回答正确，就认领该物品。
        # =================================================================
        for item in matching_items:
            print("\nTo claim this [" + item.name + "], please answer the secret question:")
            print("Question: " + item.secretQuestion)
            answer = input("Your answer: ")
            
            if answer.lower() == item.secretAnswer.lower():
                item.status = "Claimed"
                print(name + " has been successfully claimed.")
                return  
            else:
                print("Incorrect answer for this specific item.")
        
        print("Claim failed. No correct answers provided for any matching items.")
        
        
    def remove(item):
        """
        To remove a specific item from the inventory
        """
        # =================================================================
        # [Task 2 标注]: 实现了 remove 功能，从库中移除传入的 item 实例
        # =================================================================
        if item in LostFoundSys.ItemList:
            LostFoundSys.ItemList.remove(item)


    def display():
        """
        To display all the items that are currently in the inventory including both
        found and claimed ones, without showing the secret question and answer
        """
        # =================================================================
        # [Task 2 标注]: 实现了 display 基础功能，排版输出清单
        # =================================================================
        print("\nThe current inventory includes the following unclaimed items:")
        print("Status\tItem Name\tLocation Found")
        for i in LostFoundSys.ItemList:
            # =================================================================
            # [Task 6 标注]: 增加 if 判断，确保仅显示 status 为 "Found" 的未认领物品
            # =================================================================
            if i.status == "Found":
                print(i.status + '\t' + i.name + '\t\t' + i.location)
